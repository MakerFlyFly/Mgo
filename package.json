{
  "name": "mgo",
  "version": "0.1.0",
  "private": true,
  "description": "鲸鱼娘的云麦当劳 · A conversational ordering galgame powered by DeepSeek and McDonald's MCP",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:live": "node --env-file-if-exists=.env.local scripts/test-live.mjs",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "ajv": "^8.17.1",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "sharp": "0.35.5",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
